# ============================================================
# Template de configuração — pipeline Argentina
#
# Copie para .env e preencha:
#     cp .env.example .env
#
# NUNCA commite o .env real. Ele está no .gitignore, junto com
# .env.bak* — backups também carregam credenciais.
#
# Variáveis sem valor padrão são OBRIGATÓRIAS: config.py levanta
# EnvironmentError na inicialização se alguma estiver faltando.
# ============================================================

# --- URLs de download (boletins NABSA) ---
URL_SAILED=https://boletines.nabsa.com.ar/c/.../...
URL_LINEUP=https://boletines.nabsa.com.ar/c/.../...

# --- Caminhos locais ---
# Tudo sob data/, que é inteiramente gitignored. Ver ESTRUTURA.md seção 3.
DIR_SAILED_BACKUP=C:\Users\<usuario>\sailed_auto\data\raw\sailed
DIR_LINEUP_BACKUP=C:\Users\<usuario>\sailed_auto\data\raw\lineup
PATH_DATABASE=C:\Users\<usuario>\sailed_auto\data\db\Arg_sailed_database.xlsx
# O __main__.py deriva o nome datado deste path via with_stem(), então os
# snapshots Arg_sailed_database_AT_<data>_<hora>.xlsx caem em data/archive/
PATH_DATABASE_OUTPUT=C:\Users\<usuario>\sailed_auto\data\archive\Arg_sailed_database_AT.xlsx

# --- Timeouts de download, em segundos (opcional) ---
TIMEOUT_SAILED=40
TIMEOUT_LINEUP=18

# --- Correcoes conhecidas do Sailed ---
# Arquivo versionado no repositorio. Vazio = config/correcoes_sailed.csv
PATH_CORRECOES=

# --- Dashboard HTML ---
# Arquivo único e autocontido, feito para ser embutido em outra aplicação.
# Opcional: se vazio, cai em data/dashboard/arg_dashboard.html.
PATH_DASHBOARD_OUTPUT=

# --- Line-Up ---
# A tabela Arg_Lineup é append-only entre dias. Esta opção só afeta
# reexecuções no MESMO dia:
#   true  = a reexecução substitui o snapshot do dia (padrão)
#   false = a reexecução é ignorada
# O histórico de outros dias nunca é afetado. Ver ESTRUTURA.md 9.2.
LINEUP_FORCE_SNAPSHOT=true

# --- SQL Server (autenticação Windows — sem senha) ---
SQL_SERVER=Server
SQL_DATABASE=ArgentinaBD
SQL_TABLE=Arg_Sailed
SQL_TABLE_LINEUP=Arg_Lineup

# --- OneDrive / pasta sincronizada ---
# Destino da planilha consumida por pessoas. Ver a ressalva em ESTRUTURA.md,
# Fase G: a publicação por pasta sincronizada não confirma entrega.
DIR_ONEDRIVE=C:\Users\<usuario>\OneDrive - <Organizacao>\<caminho>\ARG
FILENAME_ONEDRIVE=Arg_sailed_databease.xlsx
# Quanto esperar a confirmação de sincronização antes de avisar. 0 desliga.
SYNC_ESPERA_SEGUNDOS=60

# --- SharePoint via Microsoft Graph API ---
# Substitui a pasta sincronizada por publicação com confirmação de entrega.
# Requer App Registration com Sites.Selected + concessão no site específico.
# Ver docs/graph-permission-request.md.
GRAPH_UPLOAD_ENABLED=false
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Anote a data de expiração: quando vencer, a publicação para.
GRAPH_CLIENT_SECRET=<client secret do App Registration>
GRAPH_HOST=<tenant>.sharepoint.com
GRAPH_SITE_PATH=/sites/<NomeDoSite>
GRAPH_FOLDER=<pasta>/<subpasta>

# --- E-mail (relatório diário) ---
# EMAIL_BACKEND=smtp usa as variáveis abaixo; graph usa a API do Office 365.
EMAIL_BACKEND=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=seu.email@gmail.com
# Senha de app do Google, não a senha da conta:
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=seu.email@gmail.com
# Separe múltiplos destinatários por vírgula
EMAIL_TO=destinatario@empresa.com
